# Copy to .env.local and fill in real values. NEVER commit .env.local.
# Only placeholder values are allowed in this file.
#
# ONLY the variables below are read by the app. Do not add SESSION_SECRET,
# DIRECT_URL, Upstash, Sentry or R2 variables — nothing in the code reads
# them (Phase 7 cleanup).

# --- Supabase (Postgres database + file Storage) ---
# Public value, safe to expose in the browser. Get it from the Supabase
# dashboard: Project Settings -> API -> Project URL.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# --- Supabase service-role key (SERVER ONLY — never expose in the browser) ---
# Get it from the Supabase dashboard: Project Settings -> API -> service_role.
# Used server-side only, for blog/quiz PDF uploads to Storage buckets.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# --- Postgres connection (server only) ---
# Get from Supabase: Project Settings -> Database -> Connection string (URI).
# Use the POOLED connection (port 6543, pgbouncer) for DATABASE_URL.
# Requires PostgreSQL >= 15.
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR_DB_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true

# --- Email (Resend) ---
# Password-reset, notification and signup verification emails are sent
# through Resend. Both values are required for delivery:
# - RESEND_API_KEY: create it at https://resend.com/api-keys (server
#   only — never expose in the browser, never commit a real key).
# - EMAIL_FROM: sender address on your verified domain, e.g.
#   "CodeBettle <noreply@codebettle.com>". Verify the domain first at
#   https://resend.com/domains (add the DNS records Resend shows).
# Until both are set, the app works without email: sends are skipped
# gracefully and logged, and signup never fails because email is down.
# - NEXT_PUBLIC_APP_URL (optional): public site URL used for the links
#   inside emails. Defaults to https://codebettle-web.vercel.app.
RESEND_API_KEY=
EMAIL_FROM=CodeBettle <noreply@codebettle.com>
NEXT_PUBLIC_APP_URL=https://codebettle-web.vercel.app

# --- Secret admin URL (PR #33) ---
# The admin area lives at /<ADMIN_BASE_PATH>/... instead of /admin/...
# (an extra layer of obscurity — the real security is still the login,
# sessions, rate limiting and RBAC). Set this to a long random
# URL-safe value (24+ chars, letters/digits/hyphens) in Vercel and
# redeploy; the old /admin/* URLs stop working. NEVER put the real
# value in this file or in any committed file — the repo is public.
# When unset, the dev default 'admin' is used (local dev only).
# ADMIN_BASE_PATH=portal-CHANGE-ME-TO-A-LONG-RANDOM-VALUE
