# Copy to .env.local and fill in real values. NEVER commit .env.local.
# Only placeholder values are allowed in this file.

# --- Supabase (Postgres database + file Storage) ---
# Public values, safe to expose in the browser. Get them from the Supabase dashboard:
# Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_PUBLISHABLE_KEY

# --- Postgres connection (server only) ---
# Get from Supabase: Project Settings -> Database -> Connection string (URI).
# Use the pooled connection for DATABASE_URL and the direct connection for DIRECT_URL.
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR_DB_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true
DIRECT_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR_DB_PASSWORD@db.YOUR-PROJECT-REF.supabase.co:5432/postgres?sslmode=require

# --- Sessions ---
# Long random secret used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# --- Email (Phase 1: set up later with your own domain) ---
RESEND_API_KEY=
EMAIL_FROM=noreply@yourdomain.com

# --- Rate limiting (Phase 1: Upstash Redis, free tier) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Error tracking (Phase 1/7: Sentry, free tier) ---
SENTRY_DSN=

# --- File storage (Phase 3/5: Cloudflare R2) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
