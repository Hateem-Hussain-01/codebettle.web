# Copy to .env.local and fill in real values. NEVER commit .env.local.
# Only placeholder values are allowed in this file.
#
# ONLY the variables below are read by the app. Do not add SESSION_SECRET,
# DIRECT_URL, Upstash, Sentry or R2 variables — nothing in the code reads
# them (Phase 7 cleanup).

# --- Supabase (Postgres database + file Storage) ---
# Public value, safe to expose in the browser. Get it from the Supabase
# dashboard: Project Settings -> API -> Project URL.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# --- Supabase service-role key (SERVER ONLY — never expose in the browser) ---
# Get it from the Supabase dashboard: Project Settings -> API -> service_role.
# Used server-side only, for blog/quiz PDF uploads to Storage buckets.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# --- Postgres connection (server only) ---
# Get from Supabase: Project Settings -> Database -> Connection string (URI).
# Use the POOLED connection (port 6543, pgbouncer) for DATABASE_URL.
# Requires PostgreSQL >= 15.
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR_DB_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true

# --- Email (NOT wired yet) ---
# Password-reset and notification emails stay inert until Resend is
# configured with a sending domain. Leave empty until then.
RESEND_API_KEY=
