// use prisma-8
//
// CodeBettle data contract (Prisma 8, PostgreSQL 15+).
// Source: transformation plan §3 + the existing lib/data/*.ts interfaces,
// which are preserved exactly so the seed import (Phase 2) is mechanical.
//
// Design notes:
// - Money is stored in the smallest unit as an integer (pricePkr, amountPkr)
//   to avoid floating-point errors.
// - Deletes are soft (deletedAt) for users, courses and enrolments, because
//   financial and certificate records must remain auditable.
// - Only SHA-256 hashes of tokens are stored (sessions, password resets) —
//   never the tokens themselves.
// - Instructor bio/expertise/socialLinks stay on User (as in the current
//   interfaces) instead of a separate instructor_profiles table.
// - Prisma 8 enum members take no attributes, so category/type values are
//   stored as identifiers (Web_Development, site_wide); map them to the
//   display strings ("Web Development", "site-wide") at the code boundary
//   in Phase 2.
// - Quiz models (Phase 5): Quiz, QuizQuestion, QuizOption, QuizAttempt,
//   QuizAnswer — see the models below. No quiz seed data: quizzes are
//   teacher-created content, never invented seed content.
// - Seed-import validation counts (Phase 2): 27 users (2 admin, 5 instructor,
//   20 student), 8 courses (6 paid, 2 free), 15 enrolments (11 paid, 4 free;
//   6 completed), 6 certificates, seed amountPaid total PKR 57,489.
enum Role {
  student
  instructor
  admin
}

enum UserStatus {
  active
  suspended
}

enum CourseCategory {
  Web_Development
  Mobile_Development
  Data_Science
  UI_UX_Design
  DevOps
  Programming
}

enum CourseLevel {
  beginner
  intermediate
  advanced
}

enum CourseStatus {
  draft
  published
  archived
}

// Batch lifecycle: a batch is created upcoming, starts (ongoing), then ends (completed).
enum BatchStatus {
  upcoming
  ongoing
  completed
}

enum EnrollmentPaymentStatus {
  paid
  free
  pending
}

enum PaymentStatus {
  pending
  paid
  failed
  refunded
}

enum PaymentMethod {
  bank
  easypaisa
  jazzcash
  wallet
  other
}

enum PaymentSubmissionStatus {
  submitted
  approved
  rejected
}

enum CouponType {
  percentage
  fixed
}

enum AnnouncementType {
  site_wide
  course
}

enum ApplicationStatus {
  pending
  approved
  rejected
}

enum QuizStatus {
  draft
  published
  archived
}

enum QuizQuestionType {
  mcq
  fill_blank
  checkbox
  choose_two
  choose_three
}

enum QuizAttemptStatus {
  in_progress
  submitted
}

enum QuizScoringPolicy {
  exact
  partial
}

model User {
  id                 String                  @id @onCreate(cuid(2))
  name               String
  email              String                  @unique
  passwordHash       String
  role               Role
  // Phase 2 (flags role model, user-confirmed): multi-role is boolean
  // on/off switches on this record — NOT a separate role table.
  //
  // Semantics (the single source of truth; see lib/rbac.ts):
  // - `role` is the PRIMARY role: the user's home portal / landing
  //   portal and the role shown in the UI. It is kept for backward
  //   compatibility and is never removed.
  // - `isAdmin` / `isTeacher` are ADDITIONAL capabilities. A user is an
  //   admin iff isAdmin is true, a teacher iff isTeacher is true.
  // - A user can hold both flags at once (teacher + admin). Granting
  //   admin never destroys the teacher capability, and revoking admin
  //   restores the primary role from the remaining flags (isTeacher ->
  //   'instructor', otherwise 'student') — see
  //   lib/services/admin-access-service.ts.
  // - A plain student is role 'student' with both flags false.
  // - Guards MUST use the capability helpers in lib/rbac.ts
  //   (hasAdminCapability / hasTeacherCapability), never `role ===`
  //   alone. The helpers also treat the legacy primary role as a
  //   capability (role 'admin' / 'instructor'), so rows created before
  //   the flags were backfilled — and the seed — keep working.
  isAdmin            Boolean                 @default(false)
  isTeacher          Boolean                 @default(false)
  avatar             String?
  bio                String?
  phone              String?
  expertise          String[]
  socialLinks        Json?
  notificationPrefs  Json?
  adminPermissions   Json?
  // Phase 5 (Module 23, Super Admin & Audit): explicit grant to view
  // the audit log, separate from adminPermissions. Only super-admins
  // (the two OFFICIAL_ADMINS) and users granted this flag may open
  // /admin/audit. Officials always have access, with or without the
  // flag; the flag is never seeded true.
  canViewAuditLog    Boolean                 @default(false)
  status             UserStatus              @default(active)
  emailVerifiedAt    DateTime?
  joinedAt           DateTime                @default(now())
  deletedAt          DateTime?
  createdAt          DateTime                @default(now()) @onCreate(now())
  updatedAt          temporal.UpdatedAt

  coursesTaught      Course[]                @relation("InstructorCourses")
  batchesTaught      Batch[]                 @relation("BatchInstructor")
  enrollments        Enrollment[]
  certificates       Certificate[]
  reviews            Review[]
  announcements      Announcement[]          @relation("AnnouncementAuthor")
  notifications      Notification[]
  applicationsReview InstructorApplication[] @relation("ApplicationReviewer")
  auditLogs          AuditLog[]
  loginEvents        LoginEvent[]
  passwordResets     PasswordReset[]
  emailVerifications EmailVerification[]
  sessions           Session[]
  blogPosts          BlogPost[]
  quizzesCreated     Quiz[]             @relation("QuizCreator")
  quizAttempts       QuizAttempt[]      @relation("QuizAttempts")
  notes              Note[]
  wishlist           Wishlist[]
  supportRequests    SupportRequest[]   @relation("SupportRequestStudent")
  supportRequestsResolved SupportRequest[] @relation("SupportRequestResolver")
  createdForms       FormDefinition[] @relation("FormDefinitionCreator")
  emailTemplates     EmailTemplate[]  @relation("EmailTemplateCreator")
  formSubmissions    FormSubmission[] @relation("FormSubmissionSubmitter")
  successStorySubmissions SuccessStorySubmission[] @relation("SuccessStorySubmitter")
  paymentSubmissionsReviewed PaymentSubmission[] @relation("PaymentSubmissionReviewer")
  invitationsSent    Invitation[]            @relation("InvitationInviter")
  stageHistory       ApplicationStageHistory[] @relation("StageHistoryActor")
  applicationNotes   ApplicationNote[]       @relation("ApplicationNoteAuthor")
  applications       InstructorApplication[] @relation("ApplicationApplicant")
}

model Course {
  id              String             @id @onCreate(cuid(2))
  slug            String             @unique
  title           String
  description     String
  longDescription String
  thumbnail       String
  category        CourseCategory
  level           CourseLevel
  pricePkr        Int
  isFree          Boolean            @default(false)
  instructorId    String
  instructor      User               @relation("InstructorCourses", fields: [instructorId], references: [id])
  zoomLink        String?
  schedule        Json?
  status          CourseStatus       @default(draft)
  isFeatured      Boolean            @default(false)
  isCompleted     Boolean            @default(false)
  completedAt     DateTime?
  requirements    String[]
  whatYouLearn    String[]
  tags            String[]
  enrolledCount   Int                @default(0)
  rating          Float              @default(0)
  reviewCount     Int                @default(0)
  deletedAt       DateTime?
  createdAt       DateTime           @default(now()) @onCreate(now())
  updatedAt       temporal.UpdatedAt
  // Per-course certificate template (Phase 2): the FULL HTML template
  // for this course's certificates, pasted/uploaded by an admin in the
  // course form. Null = no template attached — PDF generation falls
  // back to the default Python design (lib/certificates/template.html).
  // Stored as plain text in the DB (no Storage bucket, no repo-file
  // coupling); rendered server-side to PDF only, never served as HTML.
  certificateTemplateHtml String?

  // Public course outline PDF URL (e.g. a Supabase Storage public URL).
  // Null = no outline attached. Shown as a "Download Course Outline"
  // link on the public course detail page (visible to prospective
  // students, not gated to enrolled students). Set by an admin in the
  // course form; the PDF itself lives in Storage, only the URL is stored.
  outlineUrl String?

  modules         Module[]
  batches         Batch[]
  enrollments     Enrollment[]
  reviews         Review[]
  certificates    Certificate[]
  announcements   Announcement[]
  successStories  SuccessStorySubmission[]
  quizzes         Quiz[]
  notes           Note[]
  wishlistEntries Wishlist[]
  supportRequests SupportRequest[]
}

model Module {
  id       String   @id @onCreate(cuid(2))
  courseId String
  course   Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title    String
  position Int
  lessons  Lesson[]

  @@unique([courseId, position])
}

model Lesson {
  id           String           @id @onCreate(cuid(2))
  moduleId     String
  module       Module           @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  title        String
  position     Int
  description  String?
  recordingUrl String?
  materials    Json?
  duration     String?
  // Date of the live class session. Shown on the student/instructor course
  // pages; the seed data carries one date per lesson (all 2024-05-10).
  date         DateTime?
  progress     LessonProgress[]

  @@unique([moduleId, position])
}

// A Batch is one run/cohort of a Course (e.g. Python "Batch 08",
// "Batch 09"). A Course is the subject (created once); each Batch is
// a dated run with its own instructor, capacity and lifecycle.
// Students enrol in a specific Batch; the certificate batch comes
// from the enrolment's Batch (batchNumber -> "BATCH-<n>"). One
// certificate template per Course — only the batch number changes.
model Batch {
  id           String      @id @onCreate(cuid(2))
  courseId     String
  course       Course      @relation(fields: [courseId], references: [id])
  batchNumber  Int
  status       BatchStatus @default(upcoming)
  startDate    DateTime?
  endDate      DateTime?
  capacity     Int?
  instructorId String?
  instructor   User?       @relation("BatchInstructor", fields: [instructorId], references: [id])
  createdAt    DateTime    @default(now()) @onCreate(now())
  updatedAt    temporal.UpdatedAt

  enrollments  Enrollment[]
  successStories SuccessStorySubmission[]

  @@unique([courseId, batchNumber])
  @@index([courseId])
  @@index([instructorId])
}

model Enrollment {
  id                  String                  @id @onCreate(cuid(2))
  studentId           String
  student             User                    @relation(fields: [studentId], references: [id])
  courseId            String
  course              Course                  @relation(fields: [courseId], references: [id])
  enrolledAt          DateTime                @default(now())
  completedAt         DateTime?
  isCompleted         Boolean                 @default(false)
  paymentStatus       EnrollmentPaymentStatus @default(pending)
  couponUsed          String?
  amountPaid          Int                     @default(0)
  certificateEligible Boolean?
  deletedAt           DateTime?
  createdAt           DateTime                @default(now()) @onCreate(now())
  updatedAt           temporal.UpdatedAt

  lessonProgress      LessonProgress[]
  payments            Payment[]
  paymentSubmissions  PaymentSubmission[]
  certificate         Certificate?
  // Batch this enrolment belongs to (null = enrolled before batches
  // existed). The certificate batch comes from this batch
  // (batchNumber -> "BATCH-<n>"); courseId is kept for compatibility
  // (existing queries, the student+course duplicate check).
  batchId             String?
  batch               Batch?                  @relation(fields: [batchId], references: [id])

  @@unique([studentId, courseId])
  @@index([studentId])
  @@index([courseId])
  @@index([batchId])
}

model LessonProgress {
  enrollmentId String
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  lessonId     String
  lesson       Lesson     @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  completedAt  DateTime   @default(now())

  @@id([enrollmentId, lessonId])
  @@index([enrollmentId])
}

model Payment {
  id           String        @id @onCreate(cuid(2))
  enrollmentId String
  enrollment   Enrollment    @relation(fields: [enrollmentId], references: [id])
  provider     String
  providerRef  String?
  amountPkr    Int
  status       PaymentStatus @default(pending)
  couponId     String?
  coupon       Coupon?       @relation(fields: [couponId], references: [id])
  createdAt    DateTime      @default(now()) @onCreate(now())

  @@unique([provider, providerRef])
  @@index([status, createdAt])
}

// Phase 0/1 models (23-module plan, Modules 4 + 16 + 1).
//
// - Note / Wishlist replace the hardcoded INITIAL_NOTES /
//   INITIAL_WISHLIST on the student pages — every row is scoped to
//   one user, enforced in the repositories (userId in the where clause).
// - PaymentSubmission is a NEW model on purpose: the existing Payment
//   model is gateway-shaped (provider/providerRef unique, status
//   paid|failed|refunded) and nothing ever creates a Payment row today.
//   Manual payment verification has a different lifecycle — a student
//   submits proof of a transfer to a published payment account, an
//   admin approves or rejects it — so it gets its own reviewStatus
//   (submitted|approved|rejected) instead of overloading PaymentStatus,
//   and Payment stays untouched for future gateway use.
// - PaymentSubmission.accountSnapshot is a frozen copy of the payment
//   account (label/method/holder/numbers) taken at submit time, so
//   deleting or deactivating the account never damages history.
model Note {
  id        String   @id @onCreate(cuid(2))
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  content   String
  courseId  String?
  course    Course?  @relation(fields: [courseId], references: [id])
  createdAt DateTime @default(now()) @onCreate(now())
  updatedAt temporal.UpdatedAt

  @@index([userId, createdAt])
}

model Wishlist {
  id        String   @id @onCreate(cuid(2))
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @onCreate(now())

  @@unique([userId, courseId])
  @@index([userId])
}

model PaymentAccount {
  id            String        @id @onCreate(cuid(2))
  label         String
  method        PaymentMethod
  accountHolder String
  bankName      String?
  accountNumber String?
  iban          String?
  walletNumber  String?
  instructions  String?
  isActive      Boolean       @default(true)
  displayOrder  Int           @default(0)
  createdAt     DateTime      @default(now()) @onCreate(now())
  updatedAt     temporal.UpdatedAt

  paymentSubmissions PaymentSubmission[]

  @@index([isActive, displayOrder])
}

model PaymentSubmission {
  id               String                  @id @onCreate(cuid(2))
  enrollmentId     String
  enrollment       Enrollment              @relation(fields: [enrollmentId], references: [id])
  paymentAccountId String?
  paymentAccount   PaymentAccount?         @relation(fields: [paymentAccountId], references: [id])
  method           PaymentMethod
  amountPkr        Int
  transactionRef   String
  proofUrl         String?
  accountSnapshot  Json
  reviewStatus     PaymentSubmissionStatus @default(submitted)
  submittedAt      DateTime                @default(now())
  reviewedBy       String?
  reviewer         User?                   @relation("PaymentSubmissionReviewer", fields: [reviewedBy], references: [id])
  reviewedAt       DateTime?
  reviewNote       String?
  createdAt        DateTime                @default(now()) @onCreate(now())
  updatedAt        temporal.UpdatedAt

  @@index([enrollmentId, reviewStatus])
  @@index([reviewStatus, submittedAt])
}

model Coupon {
  id                String             @id @onCreate(cuid(2))
  code              String             @unique
  type              CouponType
  value             Int
  maxUses           Int
  usedCount         Int                @default(0)
  expiresAt         DateTime
  isActive          Boolean            @default(true)
  createdAt         DateTime           @default(now()) @onCreate(now())
  applicableCourses String[]
  payments          Payment[]
  redemptions       CouponRedemption[]
}

model CouponRedemption {
  id           String     @id @onCreate(cuid(2))
  couponId     String
  coupon       Coupon     @relation(fields: [couponId], references: [id])
  enrollmentId String
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id])
  redeemedAt   DateTime   @default(now())

  @@unique([couponId, enrollmentId])
}

model Certificate {
  id                String     @id @onCreate(cuid(2))
  studentId         String
  student           User       @relation(fields: [studentId], references: [id])
  courseId          String
  course            Course     @relation(fields: [courseId], references: [id])
  enrollmentId      String     @unique
  enrollment        Enrollment @relation(fields: [enrollmentId], references: [id])
  certificateNumber String     @unique
  verificationToken String     @unique
  issuedAt          DateTime   @default(now())
  // Certificate PDF (Phase 2): the cohort batch printed on the
  // certificate (e.g. "BATCH-8"). Null for certificates issued before
  // batches were recorded — the PDF falls back to the course default.
  batch             String?
  // Revocation (Phase 2): set when an admin revokes the certificate.
  // Null = valid. The verify page/API show a revoked certificate as
  // revoked/invalid; the row is kept for audit history.
  revokedAt         DateTime?
}

// Quiz models (Phase 5, text import in Phase 4 Module 8): a teacher
// creates a quiz for their own course, pastes AI-generated quiz text
// (or adds questions manually), and publishes it directly to students
// — there is NO review/approval step. The answer key lives server-side
// only (QuizOption.isCorrect / QuizQuestion.correctText) — attempt
// payloads must never include it. QuizQuestion.explanation is
// teacher-facing only and is never sent to students either.
// The old PDF workflow (quiz-pdfs bucket, Quiz.pdfUrl/pdfStoragePath)
// is retired: those columns are kept nullable for the historical rows
// that still reference a stored PDF, but nothing writes them any more.
model Quiz {
  id                    String            @id @onCreate(cuid(2))
  courseId              String
  course                Course            @relation(fields: [courseId], references: [id])
  title                 String
  description           String?
  topics                String[]
  difficulty            CourseLevel?
  timeLimitMin          Int?
  attemptsAllowed       Int               @default(1)
  passMark              Int?
  scoringPolicy         QuizScoringPolicy @default(exact)
  showResultsToStudents Boolean           @default(true)
  showCorrectAnswers    Boolean           @default(false)
  availableFrom         DateTime?
  availableUntil        DateTime?
  instructions          String?
  status                QuizStatus        @default(draft)
  createdById           String
  creator               User              @relation("QuizCreator", fields: [createdById], references: [id])
  pdfUrl                String?
  pdfStoragePath        String?
  parseWarnings         Json?
  deletedAt             DateTime?
  createdAt             DateTime          @default(now()) @onCreate(now())
  updatedAt             temporal.UpdatedAt

  questions             QuizQuestion[]
  attempts              QuizAttempt[]

  @@index([courseId, status])
}

model QuizQuestion {
  id              String           @id @onCreate(cuid(2))
  quizId          String
  quiz            Quiz             @relation(fields: [quizId], references: [id], onDelete: Cascade)
  type            QuizQuestionType
  position        Int
  prompt          String
  points          Int              @default(1)
  topic           String?
  difficulty      CourseLevel?
  correctText     String?
  acceptedAnswers String[]
  explanation     String?
  needsReview     Boolean          @default(false)
  reviewNote      String?

  options         QuizOption[]
  answers         QuizAnswer[]

  @@unique([quizId, position])
}

model QuizOption {
  id         String       @id @onCreate(cuid(2))
  questionId String
  question   QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  text       String
  position   Int
  isCorrect  Boolean      @default(false)

  @@unique([questionId, position])
}

model QuizAttempt {
  id            String           @id @onCreate(cuid(2))
  quizId        String
  quiz          Quiz             @relation(fields: [quizId], references: [id])
  studentId     String
  student       User             @relation("QuizAttempts", fields: [studentId], references: [id])
  status        QuizAttemptStatus @default(in_progress)
  startedAt     DateTime         @default(now())
  dueAt         DateTime?
  submittedAt   DateTime?
  score         Int?
  totalPoints   Int?
  timeSpentSec  Int?
  submittedLate Boolean          @default(false)

  answers       QuizAnswer[]

  @@index([quizId, studentId])
}

model QuizAnswer {
  id                String       @id @onCreate(cuid(2))
  attemptId         String
  attempt           QuizAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId        String
  question          QuizQuestion @relation(fields: [questionId], references: [id])
  selectedOptionIds String[]
  textAnswer        String?
  isCorrect         Boolean?
  pointsAwarded     Int          @default(0)
  needsManualReview Boolean      @default(false)

  @@unique([attemptId, questionId])
}

model Review {
  id        String   @id @onCreate(cuid(2))
  studentId String
  student   User     @relation(fields: [studentId], references: [id])
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id])
  rating    Int
  comment   String
  createdAt DateTime @default(now()) @onCreate(now())

  @@unique([studentId, courseId])
}

model Announcement {
  id        String           @id @onCreate(cuid(2))
  title     String
  content   String
  type      AnnouncementType
  courseId  String?
  course    Course?          @relation(fields: [courseId], references: [id])
  authorId  String
  author    User             @relation("AnnouncementAuthor", fields: [authorId], references: [id])
  isActive  Boolean          @default(true)
  createdAt DateTime         @default(now()) @onCreate(now())

  notifications Notification[]
}

// Phase 3 models (23-module plan, Module 7 — notifications & requests).
//
// - Notification gains: `category` (general|important|warning|
//   special_notice — stored as String like `type`, no Prisma enum),
//   `announcementId` (FK to Announcement, for receipt aggregation;
//   SetNull so deleting an announcement never deletes notifications),
//   `linkUrl`, `requiresAcknowledge` + `acknowledgedAt` (the
//   acknowledge gate for important / special-notice broadcasts).
//   One row per recipient is kept; `readAt` stays per-row.
// - SupportRequest is a NEW model on purpose: ContactMessage stays the
//   anonymous public inbox and is never overloaded. A support request
//   is always owned by one authenticated student (studentId from the
//   session, never the body), optionally linked to a course the student
//   is enrolled in. `category` / `status` are Strings (slugs — see
//   SUPPORT_REQUEST_CATEGORIES / SUPPORT_REQUEST_STATUSES in
//   lib/db/types.ts), not Prisma enums, matching Notification.type.
model Notification {
  id        String    @id @onCreate(cuid(2))
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String
  category  String    @default("general")
  announcementId String?
  announcement Announcement? @relation(fields: [announcementId], references: [id], onDelete: SetNull)
  linkUrl   String?
  requiresAcknowledge Boolean @default(false)
  acknowledgedAt DateTime?
  readAt    DateTime?
  createdAt DateTime  @default(now()) @onCreate(now())

  @@index([userId, readAt])
  @@index([announcementId])
}

model SupportRequest {
  id           String   @id @onCreate(cuid(2))
  studentId    String
  student      User     @relation("SupportRequestStudent", fields: [studentId], references: [id], onDelete: Cascade)
  category     String
  subject      String
  message      String
  courseId     String?
  course       Course?  @relation(fields: [courseId], references: [id])
  status       String   @default("new")
  attachmentUrl String?
  adminReply   String?
  resolvedBy   String?
  resolver     User?    @relation("SupportRequestResolver", fields: [resolvedBy], references: [id])
  resolvedAt   DateTime?
  createdAt    DateTime @default(now()) @onCreate(now())
  updatedAt    temporal.UpdatedAt

  @@index([studentId, createdAt])
  @@index([status, createdAt])
}

// Phase 4 — Module 7 (Footer): admin-managed footer social icons.
// One row per icon the admin adds. ONLY two things are required per
// icon: (1) Icon Name (e.g. LinkedIn), (2) Icon Link (the profile URL).
// The icon itself is auto-fetched by name (see resolvePlatformKey in
// lib/social.ts) — there is no image upload. `isEnabled` decides
// whether the footer shows it; `displayOrder` decides the order.
// The footer falls back to the hardcoded defaults in lib/social.ts
// while this table is empty, so the site works before any admin entry
// exists (and before this migration has run — the public API returns
// [] when the table is missing).
model SocialLink {
  id           String   @id @onCreate(cuid(2))
  name         String
  url          String
  displayOrder Int      @default(0)
  isEnabled    Boolean  @default(true)
  createdAt    DateTime @default(now()) @onCreate(now())
  updatedAt    temporal.UpdatedAt

  @@index([isEnabled, displayOrder])
}

// Phase 6 — Forms Builder (registration + survey forms only; NO quiz
// type — quizzes live in the Quiz models). A form's fields live in the
// `schema` Json column as { fields: FormField[] } (see
// lib/services/form-schema.ts for the exact shape + validation).
// `slug` is the URL-safe public identifier (/forms/[slug]); unique.
// `type` is 'registration' | 'survey', `status` is 'draft' |
// 'published' — only published forms are visible on the public API.
// NO file-upload field type in v1: public file upload is an abuse
// surface (storage cost + malware), so it is deliberately excluded.

// Admin Settings persistence (Settings fix). One row per setting,
// keyed by a dotted key (site.name, site.description, contact.email,
// contact.phone, contact.address, maintenance.enabled). All values
// are strings ('true' / 'false' for maintenance.enabled). NO seed
// rows: the defaults live in code (DEFAULT_SETTINGS in
// lib/services/settings-service.ts) and the service falls back to them
// whenever a row is missing — including before this migration has run,
// when the table does not exist yet and reads must never throw.
model SiteSetting {
  key       String   @id
  value     String
  updatedAt temporal.UpdatedAt
}
model FormDefinition {
  id          String   @id @onCreate(cuid(2))
  name        String
  slug        String   @unique
  type        String
  description String?
  schema      Json
  status      String   @default("draft")
  createdById String
  createdBy   User     @relation("FormDefinitionCreator", fields: [createdById], references: [id])
  createdAt   DateTime @default(now()) @onCreate(now())
  updatedAt   temporal.UpdatedAt

  submissions FormSubmission[]

  @@index([status, createdAt])
}

// One filled-in form. `data` is a Json object keyed by field id
// ({ [fieldId]: value }) and is ALWAYS validated against the STORED
// form schema at submit time — never trust a client-sent schema.
// `submitterId` is null for anonymous (signed-out) submissions.
model FormSubmission {
  id          String         @id @onCreate(cuid(2))
  formId      String
  form        FormDefinition @relation(fields: [formId], references: [id], onDelete: Cascade)
  submitterId String?
  submitter   User?          @relation("FormSubmissionSubmitter", fields: [submitterId], references: [id])
  data        Json
  reviewed    Boolean        @default(false)
  submittedAt DateTime       @default(now()) @onCreate(now())

  @@index([formId, submittedAt])
}

// Admin email template (email builder, GHL-style).
// `type` is 'broadcast' (admin-composed, sent via the notifications
// broadcast) or 'system' (a code template mirrored here for editing —
// system emails themselves still render from lib/email/templates.ts).
// `htmlBody` is the email body HTML; placeholders like {{STUDENT_NAME}}
// are resolved per recipient at send time (see lib/email/placeholders.ts).
// `isActive` false = draft (listed, not offered in the broadcast picker).
model EmailTemplate {
  id          String   @id @onCreate(cuid(2))
  name        String
  subject     String
  htmlBody    String
  type        String   @default("broadcast")
  isActive    Boolean  @default(true)
  createdById String
  createdBy   User     @relation("EmailTemplateCreator", fields: [createdById], references: [id])
  createdAt   DateTime @default(now()) @onCreate(now())
  updatedAt   temporal.UpdatedAt

  @@index([type, createdAt])
}

model InstructorApplication {
  id         String            @id @onCreate(cuid(2))
  name       String
  email      String
  phone      String?
  expertise  String?
  experience String?
  message    String?
  // Phase 2: optional free-text "anything else we should know" (multiline
  // in the form). Kept separate from `message` — message stays the
  // "Why do you want to teach?" answer and is never renamed/dropped.
  additionalInfo String?
  // Phase 2: "Why are you a good fit for CodeBettle?" — nullable in the
  // DB on purpose (required only in form validation), so no backfill is
  // needed for existing rows.
  whyGoodFit String?
  // Phase 2: links the application to the applicant's account, matched
  // by email at submit time. Nullable — existing rows have no account.
  userId     String?
  user       User?             @relation("ApplicationApplicant", fields: [userId], references: [id])
  cvUrl      String?
  linkedinUrl String?
  githubUrl  String?
  demoRecordingUrl String?
  status     ApplicationStatus @default(pending)
  reviewedBy String?
  reviewer   User?             @relation("ApplicationReviewer", fields: [reviewedBy], references: [id])
  createdAt  DateTime          @default(now()) @onCreate(now())

  stageHistory ApplicationStageHistory[]
  notes        ApplicationNote[]
}

// Phase 2 models (23-module plan, Module 22 — roles & recruitment).
//
// - ApplicationStage: the pipeline stages an application moves through
//   (e.g. Received, Screening, Demo, Approved). Admin-managed; `position`
//   is the display order. Deleting a stage never deletes history —
//   ApplicationStageHistory keeps a denormalised stageName snapshot.
// - ApplicationStageHistory: an append-only audit trail of stage moves
//   and review actions on one application. `action` values:
//   stage_assigned, approved, rejected, info_requested, onboarded.
// - ApplicationNote: an admin note on an application. isInternal=true
//   notes are admin-only; a future applicant-visible note would set it
//   false — nothing exposes notes to applicants today.
// - Invitation: an invite to join as staff. Only the SHA-256 hash of
//   the token is stored (same pattern as PasswordReset /
//   EmailVerification), single-use (usedAt) and expiring. `grants` is
//   the Json payload applied on accept: { isAdmin?: boolean,
//   isTeacher?: boolean, adminPermissions?: AdminPermissions | null }.
model ApplicationStage {
  id           String   @id @onCreate(cuid(2))
  name         String
  position     Int
  instructions String?
  createdAt    DateTime @default(now()) @onCreate(now())
  updatedAt    temporal.UpdatedAt

  history ApplicationStageHistory[]

  @@index([position])
}

model ApplicationStageHistory {
  id            String               @id @onCreate(cuid(2))
  applicationId String
  application   InstructorApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  stageId       String?
  stage         ApplicationStage?    @relation(fields: [stageId], references: [id], onDelete: SetNull)
  // Denormalised snapshot so history survives stage renames/deletes.
  stageName     String
  actorId       String?
  actor         User?                @relation("StageHistoryActor", fields: [actorId], references: [id])
  note          String?
  action        String
  createdAt     DateTime             @default(now()) @onCreate(now())

  @@index([applicationId, createdAt])
}

model ApplicationNote {
  id            String               @id @onCreate(cuid(2))
  applicationId String
  application   InstructorApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  authorId      String
  author        User                 @relation("ApplicationNoteAuthor", fields: [authorId], references: [id])
  body          String
  isInternal    Boolean              @default(true)
  createdAt     DateTime             @default(now()) @onCreate(now())

  @@index([applicationId, createdAt])
}

model Invitation {
  id           String    @id @onCreate(cuid(2))
  email        String
  firstName    String
  lastName     String
  contactNumber String?
  // Flags + adminPermissions to grant on accept (see header comment).
  // Declared as Json; the repository validates its shape on read.
  grants       Json
  // SHA-256 hash of the raw token. The raw token is never stored.
  tokenHash    String    @unique
  expiresAt    DateTime
  usedAt       DateTime?
  invitedById  String
  invitedBy    User      @relation("InvitationInviter", fields: [invitedById], references: [id])
  createdAt    DateTime  @default(now()) @onCreate(now())

  @@index([email])
}

model ContactMessage {
  id        String   @id @onCreate(cuid(2))
  name      String
  email     String
  subject   String?
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now()) @onCreate(now())
}

model BlogPost {
  id          String             @id @onCreate(cuid(2))
  slug        String             @unique
  title       String
  excerpt     String
  content     String
  pdfUrl      String?
  thumbnail   String
  category    String
  authorId    String
  author      User               @relation(fields: [authorId], references: [id])
  authorName  String
  publishedAt DateTime?
  isPublished Boolean            @default(false)
  readTime    String
  tags        String[]
  createdAt   DateTime           @default(now()) @onCreate(now())
  updatedAt   temporal.UpdatedAt
}

model Testimonial {
  id            String   @id @onCreate(cuid(2))
  studentName   String
  studentAvatar String
  courseTitle   String
  rating        Int
  comment       String
  date          DateTime @default(now())
}

// Success story submissions (Submit Your Success Story).
// A guest or a logged-in student submits a multi-step story; an admin
// reviews it (pending -> under_review -> approved / rejected) and only
// approved stories are published on /success-stories. `featured` gives
// special placement on the public page. Files are NOT stored here —
// only storage paths (profile picture + video in the public
// `success-stories` bucket; evidence documents in the private
// `application-files` bucket, opened via signed URL). The public API
// never returns email, idempotencyKey, adminNote or reviewer fields.
enum SuccessStoryStatus {
  pending
  under_review
  approved
  rejected
}

model SuccessStorySubmission {
  id                 String             @id @onCreate(cuid(2))
  submissionNumber   String             @unique
  submitterId        String?
  submitter          User?              @relation("SuccessStorySubmitter", fields: [submitterId], references: [id])
  // Step 1 — personal information
  fullName           String
  email              String
  profilePicturePath String?
  country            String
  city               String?
  designation        String?
  linkedinUrl        String?
  // Step 2 — learning experience
  courseId           String?
  course             Course?            @relation(fields: [courseId], references: [id])
  courseTitle        String
  batchId            String?
  batch              Batch?             @relation(fields: [batchId], references: [id])
  batchNumber        Int?
  joinedAt           DateTime?
  instructorName     String?
  skillsLearned      String
  experience         String
  // Step 3 — the journey
  story              String
  beforeJoining      String?
  challenges         String?
  howHelped          String?
  achievementsAfter  String?
  biggestAchievement String?
  advice             String?
  // Step 5 — professional & social profiles (all optional)
  githubUrl          String?
  instagramUrl       String?
  youtubeUrl         String?
  portfolioUrl       String?
  lablabUrl          String?
  leetcodeUrl        String?
  hackerrankUrl      String?
  otherProfileUrl    String?
  // Step 6 — video testimonial (optional)
  videoPath          String?
  videoUrl           String?
  videoDescription   String?
  // Step 7 — consent (publication / media / accuracy are required)
  consentPublication Boolean
  consentMedia       Boolean
  consentAccuracy    Boolean
  consentContact     Boolean            @default(false)
  // Review workflow
  status             SuccessStoryStatus @default(pending)
  featured           Boolean            @default(false)
  // Success Stories Management (PR #32): admin visibility + ordering.
  // `enabled` false hides an approved story from the public page while
  // keeping it in admin; `displayOrder` orders stories within their
  // featured/non-featured group (lower first); `adminCreated` marks
  // stories an admin added directly (no student submission behind them).
  enabled            Boolean            @default(true)
  displayOrder       Int                @default(0)
  adminCreated       Boolean            @default(false)
  adminNote          String?
  reviewedBy         String?
  reviewedAt         DateTime?
  idempotencyKey     String?            @unique
  submittedAt        DateTime           @default(now()) @onCreate(now())
  updatedAt          temporal.UpdatedAt

  achievements       SuccessStoryAchievement[]

  @@index([status, submittedAt])
  @@index([email, submittedAt])
}

model SuccessStoryAchievement {
  id           String                    @id @onCreate(cuid(2))
  submissionId String
  submission   SuccessStorySubmission    @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  category     String
  title        String
  organization String?
  description  String?
  achievedAt   DateTime?
  createdAt    DateTime                  @default(now()) @onCreate(now())

  evidence     SuccessStoryEvidence[]

  @@index([submissionId])
}

model SuccessStoryEvidence {
  id            String                  @id @onCreate(cuid(2))
  achievementId String
  achievement   SuccessStoryAchievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  kind          String
  label         String?
  url           String
  fileName      String?
  mime          String?
  size          Int?
  createdAt     DateTime                @default(now()) @onCreate(now())

  @@index([achievementId])
}

// ---------------------------------------------------------------------------
// Success Stories Management + home reviews carousel + Navbar Editor
// (PR #32). No seed rows: team members, reviews and nav items are all
// created by an admin; the public pages show honest empty states until
// then. Nav items fall back to the hardcoded navbar when the table is
// empty (or the migration has not run yet).
// ---------------------------------------------------------------------------

// One person on the About page Team section (moved from
// /success-stories by Eman's 13 Nov 2026 change). `level` is the
// hierarchy level — 'management' (top) | 'department' | 'trainer'
// (bottom); `department` names the department for department-level
// members (e.g. 'Design'); `orderInLevel` orders cards within a
// level. `enabled` false hides the card from the public page while
// keeping it in admin. Photos live in the public `course-images`
// bucket under `team/`; only the public URL is stored here.
model TeamMember {
  id           String   @id @onCreate(cuid(2))
  photoUrl     String?
  fullName     String
  designation  String
  bio          String?
  xUrl         String?
  linkedinUrl  String?
  githubUrl    String?
  websiteUrl   String?
  level        String   @default("management")
  department   String?
  orderInLevel Int      @default(0)
  enabled      Boolean  @default(true)
  createdAt    DateTime @default(now()) @onCreate(now())
  updatedAt    temporal.UpdatedAt

  @@index([enabled, level, orderInLevel])
}

// One review in the home page "What Our Students Say" carousel.
// `order` orders cards (lower first); `enabled` false hides the card
// from the carousel while keeping it in admin. Photos live in the
// public `course-images` bucket under `reviews/`; only the public URL
// is stored here. (This is NOT the course `Review` model above —
// that one is a per-course student rating tied to a User + Course.)
model StudentReview {
  id          String   @id @onCreate(cuid(2))
  fullName    String
  role        String
  photoUrl    String?
  rating      Int
  reviewText  String
  linkedinUrl String?
  githubUrl   String?
  websiteUrl  String?
  order       Int      @default(0)
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now()) @onCreate(now())
  updatedAt   temporal.UpdatedAt

  @@index([enabled, order])
}

// One navbar item, managed from Admin > Navbar Editor. `href` is a
// site path (e.g. /courses) or a full URL; `order` orders items left
// to right (lower first); `enabled` false hides the item from the
// navbar while keeping it in admin.
model NavItem {
  id        String   @id @onCreate(cuid(2))
  label     String
  href      String
  order     Int      @default(0)
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now()) @onCreate(now())
  updatedAt temporal.UpdatedAt

  @@index([enabled, order])
}

// Newsletter subscribers (footer Subscribe). One row per email; the
// footer posts to /api/subscribe and the admin Subscribers section
// lists them. Unsubscribe is a delete.
model Subscriber {
  id        String   @id @onCreate(cuid(2))
  email     String   @unique
  createdAt DateTime @default(now()) @onCreate(now())
}

enum BookACallStatus {
  new
  contacted
  done
}

// Book-a-call requests (footer Book a Call → /book-a-call). Free
// career-guidance calls: student questions only, no budget question.
// The booking is saved first; the email to the 3 recipients is
// best-effort (Resend may not be configured) and never blocks the save.
model BookACall {
  id               String         @id @onCreate(cuid(2))
  fullName         String
  email            String
  phone            String?
  currentStatus    String
  courseInterest   String?
  guidanceNeeded   String
  preferredContact String?
  status           BookACallStatus @default(new)
  createdAt        DateTime       @default(now()) @onCreate(now())
  updatedAt        temporal.UpdatedAt

  @@index([status, createdAt])
  @@index([email, createdAt])
}

enum AmbassadorApplicationStatus {
  pending
  approved
  rejected
}

// Campus Ambassador applications (/become-ambassador). Fields are the
// PROPOSED set — Eman will confirm the exact fields later; the model
// is built to be adjustable (fields are nullable where a future
// change could drop them). socialLinks is free text (one URL per line)
// until the exact fields are known.
model AmbassadorApplication {
  id                        String                    @id @onCreate(cuid(2))
  fullName                  String
  whatsapp                  String
  email                     String
  university                String
  departmentSemester        String
  leadershipPosition        String
  promotionPlan             String
  priorAmbassadorExperience String
  status                    AmbassadorApplicationStatus @default(pending)
  createdAt                 DateTime                  @default(now()) @onCreate(now())
  updatedAt                 temporal.UpdatedAt

  @@index([status, createdAt])
  @@index([email, createdAt])
}

model AuditLog {
  id        String   @id @onCreate(cuid(2))
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id])
  action    String
  entity    String
  entityId  String?
  detail    String?
  ip        String?
  createdAt DateTime @default(now()) @onCreate(now())

  @@index([createdAt])
}

model LoginEvent {
  id        String   @id @onCreate(cuid(2))
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  email     String
  success   Boolean
  ip        String?
  userAgent String?
  createdAt DateTime @default(now()) @onCreate(now())
}

model PasswordReset {
  id        String    @id @onCreate(cuid(2))
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now()) @onCreate(now())
}

// Email-verification tokens (auth UX upgrade). Same pattern as
// PasswordReset: only the SHA-256 hash of the token is stored, a token
// is single-use (usedAt) and expires after 24 hours. Requesting a new
// verification invalidates earlier unused tokens for the same user.
// When a token is consumed, User.emailVerifiedAt is set. Login is NOT
// blocked for unverified users.
model EmailVerification {
  id        String    @id @onCreate(cuid(2))
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now()) @onCreate(now())
}

model Session {
  id         String    @id
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now()) @onCreate(now())
  expiresAt  DateTime
  lastSeenAt DateTime  @default(now())
  revokedAt  DateTime?
  ip         String?
  userAgent  String?

  @@index([userId, expiresAt])
}
